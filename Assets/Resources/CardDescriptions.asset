    fontSize: 14
    alignment: 0
    textColor: {r: 1, g: 1, b: 1, a: 1}
    backgroundColor: {r: 0.1, g: 0.09, b: 0.07, a: 0.92}
  - key: A:PlaceChicken
    title: Colocar Galinha
    art: {fileID: 21300000, guid: e143afdec3040024ebbf7ee7ba860c0b, type: 3}
    text: "Colocar em cercado vazio\n\nProdu\xE7\xE3o: 1 ovo por dia\n\nA galinha
      pode se alimentar de insetos, anulando o efeito das pragas em qualquer planta\xE7\xE3o
      adjacente"
    boxSize: {x: 240, y: 148.6}
